{
  "name": "video-studio",
  "version": "2.0.0",
  "description": "local re-edit studio: your video + a reference video in, a reference-styled 1080p edit out — zero runtime npm dependencies",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/build-sfx.mjs && node scripts/vendor.mjs",
    "sfx": "node scripts/build-sfx.mjs",
    "vendor": "node scripts/vendor.mjs",
    "motion": "node scripts/motion.mjs",
    "i18n": "node scripts/build-i18n.mjs",
    "i18n:extract": "node scripts/extract-i18n.mjs",
    "i18n:check": "node scripts/extract-i18n.mjs --coverage",
    "models": "node scripts/fetch-models.mjs",
    "textures": "node scripts/build-textures.mjs",
    "assets": "node scripts/fetch-assets.mjs"
  }
}
